#!/bin/sh
# Same checks as CI. Enable once per clone: git config core.hooksPath .githooks
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"
if command -v ruff >/dev/null 2>&1; then ruff check .; else python3 -m ruff check .; fi
(cd frontend && npm run --silent lint)
(cd infra && npm run --silent typecheck)
